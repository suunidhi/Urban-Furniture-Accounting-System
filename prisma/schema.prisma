datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CONTACT_USER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  OTHER_EXPENSE
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
  GENERAL
}

enum AnalyticType {
  INCOME
  EXPENSE
}

enum BudgetStatus {
  DRAFT
  CONFIRMED
  REVISED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  BILLED
  INVOICED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentType {
  CUSTOMER
  VENDOR
}

enum PaymentMethod {
  CASH
  BANK
}

enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum EntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

model User {
  id           Int          @id @default(autoincrement())
  loginId      String       @unique @db.VarChar(50)
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(120)
  passwordHash String       @db.VarChar(255)
  role         UserRole     @default(ACCOUNTANT)
  status       RecordStatus @default(ACTIVE)
  contactId    Int?         @unique
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
}

model Contact {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(150)
  type         ContactType       @default(CUSTOMER)
  email        String?           @unique @db.VarChar(120)
  mobile       String?           @db.VarChar(30)
  street       String?           @db.VarChar(255)
  city         String?           @db.VarChar(100)
  state        String?           @db.VarChar(100)
  country      String?           @default("India") @db.VarChar(100)
  pincode      String?           @db.VarChar(20)
  imageUrl     String?           @db.Text
  status       RecordStatus      @default(ACTIVE)
  user         User?
  purchaseOrders PurchaseOrder[]
  vendorBills  VendorBill[]
  salesOrders  SalesOrder[]
  invoices     CustomerInvoice[]
  payments     Payment[]
  journalItems JournalItem[]
  budgetsResponsible Budget[]   @relation("BudgetResponsible")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type])
  @@index([status])
}

model ProductCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(255)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(150)
  type               ProductType         @default(GOODS)
  salesPrice         Decimal             @default(0.00) @db.Decimal(15, 2)
  costPrice          Decimal             @default(0.00) @db.Decimal(15, 2)
  categoryId         Int
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  imageUrl           String?             @db.Text
  status             RecordStatus        @default(ACTIVE)
  paymentTerms       String?             @default("30 Days") @db.VarChar(100)
  allowPartialPayment Boolean            @default(true)
  defaultDueDate     DateTime?
  purchaseOrderLines PurchaseOrderLine[]
  vendorBillLines    VendorBillLine[]
  salesOrderLines    SalesOrderLine[]
  customerInvoiceLines CustomerInvoiceLine[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Account {
  id                 Int           @id @default(autoincrement())
  code               String        @unique @db.VarChar(30)
  name               String        @db.VarChar(150)
  type               AccountType
  parentId           Int?
  parent             Account?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Account[]     @relation("AccountHierarchy")
  isActive           Boolean       @default(true)
  defaultDebitJournals  Journal[]  @relation("JournalDefaultDebit")
  defaultCreditJournals Journal[]  @relation("JournalDefaultCredit")
  journalItems       JournalItem[]
  vendorBillLines    VendorBillLine[]
  customerInvoiceLines CustomerInvoiceLine[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([type])
  @@index([parentId])
}

model Journal {
  id                    Int            @id @default(autoincrement())
  name                  String         @db.VarChar(100)
  code                  String         @unique @db.VarChar(20)
  type                  JournalType
  defaultDebitAccountId  Int?
  defaultDebitAccount   Account?       @relation("JournalDefaultDebit", fields: [defaultDebitAccountId], references: [id], onDelete: SetNull)
  defaultCreditAccountId Int?
  defaultCreditAccount  Account?       @relation("JournalDefaultCredit", fields: [defaultCreditAccountId], references: [id], onDelete: SetNull)
  journalEntries        JournalEntry[]
  vendorBills           VendorBill[]
  customerInvoices      CustomerInvoice[]
  payments              Payment[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([type])
}

model AnalyticAccount {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique @db.VarChar(100)
  type                 AnalyticType          @default(EXPENSE)
  isActive             Boolean               @default(true)
  budgets              Budget[]
  purchaseOrderLines   PurchaseOrderLine[]
  vendorBillLines      VendorBillLine[]
  salesOrderLines      SalesOrderLine[]
  customerInvoiceLines CustomerInvoiceLine[]
  journalItems         JournalItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([type])
}

model Budget {
  id                   Int             @id @default(autoincrement())
  name                 String          @db.VarChar(150)
  startDate            DateTime
  endDate              DateTime
  responsibleId        Int?
  responsibleContact   Contact?        @relation("BudgetResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  analyticAccountId    Int
  analyticAccount      AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  type                 AnalyticType    @default(EXPENSE)
  committedAmount      Decimal         @default(0.00) @db.Decimal(15, 2)
  status               BudgetStatus    @default(DRAFT)
  notes                String?         @db.Text
  originalBudgetId     Int?
  originalBudget       Budget?         @relation("BudgetRevision", fields: [originalBudgetId], references: [id], onDelete: SetNull)
  revisedBudgets       Budget[]        @relation("BudgetRevision")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([analyticAccountId])
  @@index([status])
  @@index([originalBudgetId])
}

model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNumber     String              @unique @db.VarChar(50)
  vendorId     Int
  vendor       Contact             @relation(fields: [vendorId], references: [id])
  poDate       DateTime            @default(now())
  paymentTerms String?             @db.VarChar(100)
  status       OrderStatus         @default(DRAFT)
  notes        String?             @db.Text
  totalAmount  Decimal             @default(0.00) @db.Decimal(15, 2)
  lines        PurchaseOrderLine[]
  vendorBill   VendorBill?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderLine {
  id                Int              @id @default(autoincrement())
  purchaseOrderId   Int
  purchaseOrder     PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: SetNull)
  quantity          Decimal          @default(1.00) @db.Decimal(15, 2)
  unitPrice         Decimal          @default(0.00) @db.Decimal(15, 2)
  total             Decimal          @default(0.00) @db.Decimal(15, 2)

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([analyticAccountId])
}

model VendorBill {
  id              Int                 @id @default(autoincrement())
  billNumber      String              @unique @db.VarChar(50)
  reference       String?             @db.VarChar(100)
  vendorId        Int
  vendor          Contact             @relation(fields: [vendorId], references: [id])
  billDate        DateTime            @default(now())
  accountingDate  DateTime            @default(now())
  dueDate         DateTime
  paymentTerms    String?             @db.VarChar(100)
  journalId       Int
  journal         Journal             @relation(fields: [journalId], references: [id])
  purchaseOrderId Int?                @unique
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  status          InvoiceStatus       @default(DRAFT)
  subtotal        Decimal             @default(0.00) @db.Decimal(15, 2)
  taxAmount       Decimal             @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal             @default(0.00) @db.Decimal(15, 2)
  paidAmount      Decimal             @default(0.00) @db.Decimal(15, 2)
  amountDue       Decimal             @default(0.00) @db.Decimal(15, 2)
  ocrRawData      String?             @db.LongText
  lines           VendorBillLine[]
  journalEntry    JournalEntry?
  allocations     PaymentAllocation[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([journalId])
}

model VendorBillLine {
  id                Int              @id @default(autoincrement())
  vendorBillId      Int
  vendorBill        VendorBill       @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  description       String?          @db.VarChar(255)
  accountId         Int
  account           Account          @relation(fields: [accountId], references: [id])
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: SetNull)
  quantity          Decimal          @default(1.00) @db.Decimal(15, 2)
  unitPrice         Decimal          @default(0.00) @db.Decimal(15, 2)
  taxRate           Decimal          @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal          @default(0.00) @db.Decimal(15, 2)
  subtotal          Decimal          @default(0.00) @db.Decimal(15, 2)
  total             Decimal          @default(0.00) @db.Decimal(15, 2)

  @@index([vendorBillId])
  @@index([productId])
  @@index([accountId])
  @@index([analyticAccountId])
}

model SalesOrder {
  id              Int                 @id @default(autoincrement())
  soNumber        String              @unique @db.VarChar(50)
  customerId      Int
  customer        Contact             @relation(fields: [customerId], references: [id])
  soDate          DateTime            @default(now())
  status          OrderStatus         @default(DRAFT)
  notes           String?             @db.Text
  subtotal        Decimal             @default(0.00) @db.Decimal(15, 2)
  taxAmount       Decimal             @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal             @default(0.00) @db.Decimal(15, 2)
  lines           SalesOrderLine[]
  customerInvoice CustomerInvoice?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([customerId])
  @@index([status])
}

model SalesOrderLine {
  id                Int              @id @default(autoincrement())
  salesOrderId      Int
  salesOrder        SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: SetNull)
  quantity          Decimal          @default(1.00) @db.Decimal(15, 2)
  unitPrice         Decimal          @default(0.00) @db.Decimal(15, 2)
  taxRate           Decimal          @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal          @default(0.00) @db.Decimal(15, 2)
  subtotal          Decimal          @default(0.00) @db.Decimal(15, 2)
  total             Decimal          @default(0.00) @db.Decimal(15, 2)

  @@index([salesOrderId])
  @@index([productId])
  @@index([analyticAccountId])
}

model CustomerInvoice {
  id           Int                 @id @default(autoincrement())
  invoiceNumber String             @unique @db.VarChar(50)
  reference    String?             @db.VarChar(100)
  customerId   Int
  customer     Contact             @relation(fields: [customerId], references: [id])
  invoiceDate  DateTime            @default(now())
  dueDate      DateTime
  paymentTerms String?             @db.VarChar(100)
  journalId    Int
  journal      Journal             @relation(fields: [journalId], references: [id])
  salesOrderId Int?                @unique
  salesOrder   SalesOrder?         @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  status       InvoiceStatus       @default(DRAFT)
  subtotal     Decimal             @default(0.00) @db.Decimal(15, 2)
  taxAmount    Decimal             @default(0.00) @db.Decimal(15, 2)
  totalAmount  Decimal             @default(0.00) @db.Decimal(15, 2)
  paidAmount   Decimal             @default(0.00) @db.Decimal(15, 2)
  amountDue    Decimal             @default(0.00) @db.Decimal(15, 2)
  ocrRawData   String?             @db.LongText
  lines        CustomerInvoiceLine[]
  journalEntry JournalEntry?
  allocations  PaymentAllocation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([journalId])
}

model CustomerInvoiceLine {
  id                Int              @id @default(autoincrement())
  customerInvoiceId Int
  customerInvoice   CustomerInvoice  @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  description       String?          @db.VarChar(255)
  accountId         Int
  account           Account          @relation(fields: [accountId], references: [id])
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: SetNull)
  quantity          Decimal          @default(1.00) @db.Decimal(15, 2)
  unitPrice         Decimal          @default(0.00) @db.Decimal(15, 2)
  taxRate           Decimal          @default(0.00) @db.Decimal(5, 2)
  taxAmount         Decimal          @default(0.00) @db.Decimal(15, 2)
  subtotal          Decimal          @default(0.00) @db.Decimal(15, 2)
  total             Decimal          @default(0.00) @db.Decimal(15, 2)

  @@index([customerInvoiceId])
  @@index([productId])
  @@index([accountId])
  @@index([analyticAccountId])
}

model Payment {
  id            Int                 @id @default(autoincrement())
  paymentNumber String              @unique @db.VarChar(50)
  type          PaymentType         @default(CUSTOMER)
  partnerId     Int
  partner       Contact             @relation(fields: [partnerId], references: [id])
  amount        Decimal             @default(0.00) @db.Decimal(15, 2)
  paymentMethod PaymentMethod       @default(BANK)
  journalId     Int
  journal       Journal             @relation(fields: [journalId], references: [id])
  paymentDate   DateTime            @default(now())
  reference     String?             @db.VarChar(100)
  status        PaymentStatus       @default(POSTED)
  notes         String?             @db.Text
  allocations   PaymentAllocation[]
  journalEntry  JournalEntry?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([partnerId])
  @@index([journalId])
  @@index([status])
}

model PaymentAllocation {
  id                Int              @id @default(autoincrement())
  paymentId         Int
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customerInvoiceId Int?
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)
  vendorBillId      Int?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  amountAllocated   Decimal          @default(0.00) @db.Decimal(15, 2)
  createdAt         DateTime         @default(now())

  @@index([paymentId])
  @@index([customerInvoiceId])
  @@index([vendorBillId])
}

model JournalEntry {
  id                Int              @id @default(autoincrement())
  entryNumber       String           @unique @db.VarChar(50)
  date              DateTime         @default(now())
  journalId         Int
  journal           Journal          @relation(fields: [journalId], references: [id])
  status            EntryStatus      @default(POSTED)
  reference         String?          @db.VarChar(100)
  sourceType        String?          @db.VarChar(50)
  sourceId          Int?
  vendorBillId      Int?             @unique
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: SetNull)
  customerInvoiceId Int?             @unique
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)
  paymentId         Int?             @unique
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  totalDebit        Decimal          @default(0.00) @db.Decimal(15, 2)
  totalCredit       Decimal          @default(0.00) @db.Decimal(15, 2)
  items             JournalItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([journalId])
  @@index([status])
  @@index([date])
}

model JournalItem {
  id                Int              @id @default(autoincrement())
  journalEntryId    Int
  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId         Int
  account           Account          @relation(fields: [accountId], references: [id])
  partnerId         Int?
  partner           Contact?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: SetNull)
  description       String?          @db.VarChar(255)
  debit             Decimal          @default(0.00) @db.Decimal(15, 2)
  credit            Decimal          @default(0.00) @db.Decimal(15, 2)
  createdAt         DateTime         @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@index([partnerId])
  @@index([analyticAccountId])
}
